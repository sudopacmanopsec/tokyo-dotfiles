{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "modules-left": [
    "custom/tux",
    "custom/tag1",
    "custom/tag2",
    "custom/tag3",
    "custom/tag4",
    "custom/tag5",
    "custom/tag6",
    "custom/tag7",
    "custom/tag8",
    "custom/tag9",
    "custom/music",
    "wlr/taskbar"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "network",
    "pulseaudio",
    "clock"
  ],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },
  "custom/tux": {
    "format": "",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "foot"
  },
  "custom/music": {
    "exec": "~/.config/waybar/scripts/music.sh",
    "return-type": "json",
    "format": "{text}",
    "max-length": 40,
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/music-click.sh",
    "on-click-middle": "playerctl previous",
    "on-click-right": "playerctl next",
    "on-double-click": "~/.config/waybar/scripts/music-click.sh double"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle allowed"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "tooltip": false,
    "on-click": "foot -e btop"
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "interval": 5,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used ({percentage}%)",
    "on-click": "foot -e btop"
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": " {temperatureC}°",
    "interval": 5,
    "tooltip": false,
    "on-click": "foot -e btop"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "foot -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "Volume {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A %e %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "custom/tag1": {
    "exec": "~/.config/waybar/scripts/tag.sh 1",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,1"
  },
  "custom/tag2": {
    "exec": "~/.config/waybar/scripts/tag.sh 2",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,2"
  },
  "custom/tag3": {
    "exec": "~/.config/waybar/scripts/tag.sh 3",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,3"
  },
  "custom/tag4": {
    "exec": "~/.config/waybar/scripts/tag.sh 4",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,4"
  },
  "custom/tag5": {
    "exec": "~/.config/waybar/scripts/tag.sh 5",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,5"
  },
  "custom/tag6": {
    "exec": "~/.config/waybar/scripts/tag.sh 6",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,6"
  },
  "custom/tag7": {
    "exec": "~/.config/waybar/scripts/tag.sh 7",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,7"
  },
  "custom/tag8": {
    "exec": "~/.config/waybar/scripts/tag.sh 8",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,8"
  },
  "custom/tag9": {
    "exec": "~/.config/waybar/scripts/tag.sh 9",
    "return-type": "json",
    "format": "{}",
    "on-click": "mmsg dispatch view,9"
  }
}
