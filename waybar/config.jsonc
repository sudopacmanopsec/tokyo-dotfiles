
{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,

  "modules-left": [
    "custom/gentoo",
    "ext/workspaces",
    "custom/music",
    "wlr/taskbar"
  ],
  "modules-center": [],
  "modules-right": [
    "tray",
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "network",
    "pulseaudio",
    "clock"
  ],

"ext/workspaces": {
  "format": "{name}",
  "ignore-hidden": true,
  "sort-by-id": true,
  "on-click": "activate",
  "on-click-right": "deactivate"
  },

"wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": []
  },

  "custom/gentoo": {
    "format": "\uf30d",
    "tooltip": false,
    "on-click": "rofi -show drun",
    "on-click-right": "foot"
  },

"custom/music": {
  "exec": "~/.config/waybar/scripts/music.sh",
  "return-type": "json",
  "format": "{text}",
  "interval": 1,
  "max-length": 40,
  "tooltip": true,
  "on-click": "playerctl play-pause",
  "on-click-middle": "playerctl previous",
  "on-click-right": "playerctl next"
},

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\uf06e",
      "deactivated": "\uf070"
    },
    "tooltip-format-activated": "Idle inhibited",
    "tooltip-format-deactivated": "Idle allowed"
  },

"cpu": {
  "format": "\uf2db {usage}%",
  "interval": 3,
  "tooltip": false,
  "on-click": "foot -e btop"
},

"memory": {
  "format": "\uDB80\uDF5B {used:0.1f}G",
  "interval": 5,
  "tooltip-format": "{used:0.1f}G / {total:0.1f}G used ({percentage}%)",
  "on-click": "foot -e btop"
},

"temperature": {
  "critical-threshold": 80,
  "format": "\uf2c9 {temperatureC}\u00b0",
  "interval": 5,
  "tooltip": false,
  "on-click": "foot -e btop"
},

"network": {
  "format-wifi": "\uf1eb",
  "format-ethernet": "\uDB80\uDE00",
  "format-disconnected": "\uf071",
  "tooltip-format-wifi": "{essid} ({signalStrength}%)",
  "tooltip-format-ethernet": "{ifname}",
  "tooltip-format-disconnected": "Disconnected",
  "interval": 3,
  "on-click": "foot -e nmtui"
},

"pulseaudio": {
  "format": "{icon} {volume}",
  "format-muted": "\uf026",
  "format-icons": {
    "default": ["\uf027", "\uf027", "\uf028"]
  },
  "tooltip-format": "Volume {volume}%",
  "scroll-step": 5,
  "on-click": "pavucontrol",
  "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
},

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "clock": {
    "format": "{:%I:%M %p}",
    "format-alt": "{:%A %e %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  }
}

