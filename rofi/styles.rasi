/*
 * Tokyo Night rofi theme (compact, square, tall)
 */

configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus";
  font: "JetBrainsMono Nerd Font Propo 10";

  drun-display-format: "{name}";
  display-drun: "Apps";
  display-run: "Run";
  display-window: "Windows";

  kb-screenshot: "Super+Shift+S";
  kb-select-1: "Control+1";
  kb-select-2: "Control+2";
  kb-select-3: "Control+3";
  kb-select-4: "Control+4";
  kb-select-5: "Control+5";
  kb-select-6: "Control+6";
  kb-select-7: "Control+7";
  kb-select-8: "Control+8";
  kb-select-9: "Control+9";
  kb-select-10: "Control+0";
}

* {
  bg:          #1a1b26F2;
  bg-alt:      #1f2030;
  fg:          #c0caf5;
  muted:       #414868;
  accent:      #7aa2f7;
  accent-alt:  #bb9af7;
  accent-dim:  #2a2c42;
  urgent:      #f7768e;

  background-color: transparent;
  text-color:       @fg;
  margin:           0;
  padding:          0;
  spacing:          0;
}

window {
  location:         center;
  anchor:           center;
  width:            320px;
  background-color: @bg;
  border:           1px;
  border-color:     @accent-dim;
  border-radius:    0px;
}

mainbox {
  padding:  6px;
  spacing:  6px;
  children: [ inputbar, listview ];
}

/* ---------- search bar ---------- */
inputbar {
  children:         [ textbox-prompt-colon, entry ];
  spacing:          8px;
  padding:          5px 10px;
  background-color: @bg-alt;
  border:           0px 0px 2px 0px;
  border-color:     @accent-alt;
  border-radius:    0px;
}

textbox-prompt-colon {
  expand:     false;
  str:        "❯";
  text-color: @accent;
}

entry {
  placeholder:       " Search…";
  placeholder-color: @muted;
  text-color:        @fg;
  cursor-color:      @accent;
}

/* ---------- results ---------- */
listview {
  lines:        12;
  columns:      1;
  fixed-height: true;
  scrollbar:    false;
  cycle:        true;
  spacing:      1px;
}

element {
  padding:       4px 8px;
  spacing:       8px;
  border-radius: 0px;
}

element-icon {
  size:           18px;
  vertical-align: 0.5;
}

element-text {
  text-color:     inherit;
  vertical-align: 0.5;
  highlight:      inherit;
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color:       @fg;
  highlight:        bold #bb9af7;
}

element selected.normal,
element selected.active {
  background-color: @accent;
  text-color:       #1a1b26;
  highlight:        bold underline #1a1b26;
}

element normal.active,
element alternate.active {
  text-color: @accent-alt;
  highlight:  bold #bb9af7;
}

element normal.urgent,
element alternate.urgent,
element selected.urgent {
  text-color: @urgent;
}

